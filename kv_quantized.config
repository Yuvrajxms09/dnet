# E3A: Quantized KV cache (8-bit)
# Test baseline quantized KV cache behavior

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Default wire and pool settings
# DNET_TRANSPORT_WIRE_DTYPE=fp16
# DNET_TRANSPORT_COMPRESS=false
# DNET_COMPUTE_INPUT_POOL_MB=512
# DNET_COMPUTE_OUTPUT_POOL_MB=512

# Quantized KV cache (8-bit) - current default
DNET_KV_MODE=8bit
