# E3B: Embedding memory stress test
# Reduce memory pools to force different embedding loading strategies

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Small memory pools - stress test embedding memory allocation
DNET_COMPUTE_INPUT_POOL_MB=128
DNET_COMPUTE_OUTPUT_POOL_MB=128

# Default KV cache
# DNET_KV_MODE=8bit

# Hypothesis: Smaller pools force embeddings to use different allocation strategies
