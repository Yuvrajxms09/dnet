# E2A: Default memory pools (512MB each)
# Test baseline memory pool behavior

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Default wire settings (fp16, no compression)
# DNET_TRANSPORT_WIRE_DTYPE=fp16
# DNET_TRANSPORT_COMPRESS=false

# Default memory pools (512MB each)
# DNET_COMPUTE_INPUT_POOL_MB=512
# DNET_COMPUTE_OUTPUT_POOL_MB=512

# Default KV cache (8-bit quantized)
# DNET_KV_MODE=8bit
