# Q8 configuration (E1C) - Enable Q8 quantization + compression
# This tests H1: whether Q8 wire (true 8-bit quantization) vs fp16 impacts memory usage
# Matches DLlama's Q80 approach
#
# Note: Q8 combines quantization (8-bit codes + fp16 scales/biases) + sparse compression
# This should achieve ~50% bandwidth reduction like DLlama's Q80 pipes

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Enable Q8 quantization + compression for inter-stage communication
# This uses q8 wire dtype: quantizes to 8-bit + sparse compression
DNET_TRANSPORT_WIRE_DTYPE=q8
DNET_TRANSPORT_COMPRESS=true

# Wire dtype (q8 is used, then quantized via mx.quantize + compressed)
# Q8 provides true 8-bit quantization like DLlama's Q80 pipes

# Default memory pools (512MB each) - keep same as baseline
# DNET_COMPUTE_INPUT_POOL_MB=512
# DNET_COMPUTE_OUTPUT_POOL_MB=512

# Default KV cache (fp16) - keep same as baseline
# DNET_KV_MODE=fp16
