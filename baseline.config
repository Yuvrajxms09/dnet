# Baseline configuration (E1A) - Current default behavior
# fp16 wire, no compression, default pools

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Default transport settings (fp16 wire)
# DNET_TRANSPORT_WIRE_DTYPE=fp16  # This is the default
DNET_TRANSPORT_COMPRESS=false

# Default memory pools (512MB each)
# DNET_COMPUTE_INPUT_POOL_MB=512   # This is the default
# DNET_COMPUTE_OUTPUT_POOL_MB=512  # This is the default

# Default KV cache (fp16)
# DNET_KV_MODE=fp16  # This is the default






cat > .env << 'EOF'
# Baseline configuration (E1A) - Current default behavior
# fp16 wire, no compression, default pools

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Default transport settings (fp16 wire)
# DNET_TRANSPORT_WIRE_DTYPE=fp16  # This is the default
DNET_TRANSPORT_COMPRESS=false

# Default memory pools (512MB each)
# DNET_COMPUTE_INPUT_POOL_MB=512   # This is the default
# DNET_COMPUTE_OUTPUT_POOL_MB=512  # This is the default

# Default KV cache (fp16)
# DNET_KV_MODE=fp16  # This is the default
EOF
