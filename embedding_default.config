# E3A: Embedding/LM head default behavior
# Test current embedding configuration (dense vs quantized, tied vs untied)

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Default memory pools - let model use its natural embedding strategy
DNET_COMPUTE_INPUT_POOL_MB=512
DNET_COMPUTE_OUTPUT_POOL_MB=512

# Default KV cache
# DNET_KV_MODE=8bit

