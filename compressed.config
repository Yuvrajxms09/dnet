# Compressed configuration (E1B) - Enable sparse compression
# This tests H1: whether compressed wire (sparse_v1) vs raw fp16 impacts memory usage
#
# Note: Compression is controlled by DNET_TRANSPORT_COMPRESS, not wire_dtype.
# When compress=true, activations are sparse-compressed before sending.

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Enable compression for inter-stage communication
# This uses sparse_v1 format: keeps 90% of columns (drops 10% smallest norm columns)
DNET_TRANSPORT_COMPRESS=true

# Wire dtype (fp16 is used, then compressed via sparse_v1 format)
# DNET_TRANSPORT_WIRE_DTYPE=fp16  # Default

# Default memory pools (512MB each) - keep same as baseline
# DNET_COMPUTE_INPUT_POOL_MB=512
# DNET_COMPUTE_OUTPUT_POOL_MB=512

# Default KV cache (fp16) - keep same as baseline
# DNET_KV_MODE=fp16
