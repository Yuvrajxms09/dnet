# Compressed configuration (E1B) - Enable qsparse8_v1 compression
# This tests H1: whether fp16 wire vs qsparse8_v1 compression impacts memory usage

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Enable compression for inter-stage communication
DNET_TRANSPORT_WIRE_DTYPE=qsparse8_v1
DNET_TRANSPORT_COMPRESS=true

# Default memory pools (512MB each) - keep same as baseline
# DNET_COMPUTE_INPUT_POOL_MB=512   # This is the default
# DNET_COMPUTE_OUTPUT_POOL_MB=512  # This is the default

# Default KV cache (fp16) - keep same as baseline
# DNET_KV_MODE=fp16  # This is the default
