# Compressed configuration (E1B) - qsparse8_v1 compression
# This tests H1: whether qsparse8_v1 wire vs raw fp16 impacts memory usage

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Enable qsparse8_v1 compression for inter-stage communication
DNET_TRANSPORT_COMPRESS=true

# Wire dtype remains fp16 (quantization happens during compression)
# DNET_TRANSPORT_WIRE_DTYPE=fp16  # Default

# Default memory pools (512MB each) - keep same as baseline
# DNET_COMPUTE_INPUT_POOL_MB=512
# DNET_COMPUTE_OUTPUT_POOL_MB=512

# Default KV cache (fp16) - keep same as baseline
# DNET_KV_MODE=fp16


cat > .env << 'EOF'
# Compressed configuration (E1B) - qsparse8_v1 compression
# This tests H1: whether qsparse8_v1 wire vs raw fp16 impacts memory usage

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Enable qsparse8_v1 compression for inter-stage communication
DNET_TRANSPORT_COMPRESS=true

# Wire dtype remains fp16 (quantization happens during compression)
# DNET_TRANSPORT_WIRE_DTYPE=fp16  # Default

# Default memory pools (512MB each) - keep same as baseline
# DNET_COMPUTE_INPUT_POOL_MB=512
# DNET_COMPUTE_OUTPUT_POOL_MB=512

# Default KV cache (fp16) - keep same as baseline
# DNET_KV_MODE=fp16
EOF
