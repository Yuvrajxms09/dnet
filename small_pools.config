# E2B: Small memory pools (128MB each)
# Test memory pressure with smaller pools

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Default wire settings (fp16, no compression)
# DNET_TRANSPORT_WIRE_DTYPE=fp16
# DNET_TRANSPORT_COMPRESS=false

# Small memory pools (128MB each) - test memory pressure
DNET_COMPUTE_INPUT_POOL_MB=128
DNET_COMPUTE_OUTPUT_POOL_MB=128

# Default KV cache (8-bit quantized)
# DNET_KV_MODE=8bit
