# E3C: Embedding extreme stress test
# Use minimal memory pools to test embedding behavior under severe constraints

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Minimal memory pools - extreme embedding stress test
DNET_COMPUTE_INPUT_POOL_MB=64
DNET_COMPUTE_OUTPUT_POOL_MB=64

# Default KV cache
# DNET_KV_MODE=8bit

# Hypothesis: 64MB pools will reveal if embeddings cause memory spikes (H2)
