# E2C: Tiny memory pools (64MB each)
# Test extreme memory pressure - Issue #73 specifies 64MB

# Enable detailed logging for memory investigation
DNET_PROFILE=true
DNET_LOG=INFO

# Default wire settings (fp16, no compression)
# DNET_TRANSPORT_WIRE_DTYPE=fp16
# DNET_TRANSPORT_COMPRESS=false

# Tiny memory pools (64MB each) - extreme memory pressure test
DNET_COMPUTE_INPUT_POOL_MB=64
DNET_COMPUTE_OUTPUT_POOL_MB=64

# Default KV cache (8-bit quantized)
# DNET_KV_MODE=8bit
