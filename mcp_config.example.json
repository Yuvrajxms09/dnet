{
  "github": {
    "url": "https://api.githubcopilot.com/mcp/",
    "transport": "http",
    "headers": {
      "Authorization": "Bearer YOUR_GITHUB_TOKEN_HERE"
    }
  },
  "filesystem": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-filesystem", "~"],
    "transport": "stdio"
  },
  "huggingface": {
    "command": "npx",
    "args": ["-y", "@modelcontextprotocol/server-huggingface"],
    "transport": "stdio"
  }
}

